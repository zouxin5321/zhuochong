{
  "id": "builtin-default",
  "name": "小卓",
  "version": "1.0.0",
  "author": "zhuochong",
  "description": "内置示例角色：会呼吸、会眨眼，点一下会跳起来",
  "license": "CC0-1.0",
  "minHost": "0.1.0",
  "scale": 2,
  "defaultAction": "idle",
  "sprite": {
    "file": "spritesheet.png",
    "cellWidth": 64,
    "cellHeight": 64,
    "columns": 8,
    "rows": 3
  },
  "actions": {
    "idle": { "row": 0, "frames": 4, "fps": 4, "loop": true },
    "happy": { "row": 1, "frames": 4, "fps": 8, "loop": false, "next": "idle" },
    "drag": { "row": 2, "frames": 2, "fps": 8, "loop": true }
  }
}
