{
  "id": "calico-cat",
  "name": "三花",
  "version": "1.3.0",
  "author": "zhuochong",
  "description": "蓬松长毛的三花，脸颊两撮绒毛大尾巴，慢吞吞地爬",
  "license": "CC0-1.0",
  "minHost": "0.1.0",
  "scale": 1,
  "defaultAction": "idle",
  "sprite": {
    "file": "spritesheet.png",
    "cellWidth": 128,
    "cellHeight": 128,
    "columns": 8,
    "rows": 10
  },
  "actions": {
    "idle": {
      "row": 0,
      "frames": 4,
      "fps": 4,
      "loop": true
    },
    "jump": {
      "row": 1,
      "frames": 4,
      "fps": 10,
      "loop": false,
      "next": "idle"
    },
    "drag": {
      "row": 2,
      "frames": 2,
      "fps": 8,
      "loop": true
    },
    "roll": {
      "row": 3,
      "frames": 8,
      "fps": 14,
      "loop": false,
      "next": "idle"
    },
    "crawl": {
      "row": 4,
      "frames": 4,
      "fps": 6,
      "loop": false,
      "next": "idle"
    },
    "wiggle": {
      "row": 5,
      "frames": 4,
      "fps": 8,
      "loop": false,
      "next": "idle"
    },
    "spin": {
      "row": 6,
      "frames": 8,
      "fps": 12,
      "loop": false,
      "next": "idle"
    },
    "sleep": {
      "row": 7,
      "frames": 4,
      "fps": 2.5,
      "loop": true
    },
    "wave": {
      "row": 8,
      "frames": 4,
      "fps": 7,
      "loop": false,
      "next": "idle"
    },
    "dizzy": {
      "row": 9,
      "frames": 4,
      "fps": 6,
      "loop": false,
      "next": "idle"
    }
  },
  "behavior": {
    "click": [
      "jump",
      "roll",
      "spin",
      "wiggle",
      "wave",
      "crawl"
    ],
    "ambient": [
      "crawl",
      "wiggle",
      "spin"
    ],
    "doubleClick": "spin",
    "combo": {
      "count": 4,
      "windowMs": 1600,
      "action": "dizzy"
    },
    "sleep": {
      "afterMs": 120000,
      "action": "sleep"
    },
    "drag": "drag",
    "wake": "jump"
  }
}
